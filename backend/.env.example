THAILEX_SPARQL_ENDPOINT=http://localhost:7200/repositories/thailex
THAILEX_SELECTOR_MODE=heuristic
THAILEX_REQUEST_TIMEOUT_SECONDS=30
THAILEX_MAX_GRAPH_EDGES=50

# Optional: a failed or invalid LLM response is returned as an API error.
THAILLM_API_KEY=
THAILLM_MODEL=Pathumma-ThaiLLM-qwen3-8b-think-3.0.0
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
THAILLM_MAX_TOKENS=1200
THAILLM_TEMPERATURE=0.0

# Optional: only needed when THAILEX_SELECTOR_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
