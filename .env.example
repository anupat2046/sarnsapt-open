# Copy this file to .env. The real .env is ignored by Git.

# Use "heuristic" for fully offline operation, "thaillm" for ThaiLLM,
# or "openai" for the existing OpenAI Responses selector.
THAILEX_SELECTOR_MODE=heuristic
THAILEX_REQUEST_TIMEOUT_SECONDS=30
THAILEX_MAX_GRAPH_EDGES=50
# How often (seconds) the in-memory word list is reloaded from GraphDB after new imports
THAILEX_LEXICON_TTL_SECONDS=300

# Paste the full ThaiLLM token after the equals sign in your local .env only.
THAILLM_API_KEY=
THAILLM_MODEL=Pathumma-ThaiLLM-qwen3-8b-think-3.0.0
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
THAILLM_MAX_TOKENS=1200
THAILLM_TEMPERATURE=0.0

# Existing optional OpenAI selector configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
