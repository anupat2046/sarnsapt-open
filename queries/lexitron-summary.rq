PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX tlkg: <https://w3id.org/thailex/ontology/>

SELECT
  (COUNT(DISTINCT ?entry) AS ?entryCount)
  (COUNT(DISTINCT ?sense) AS ?senseCount)
  (COUNT(DISTINCT ?definition) AS ?definitionCount)
WHERE {
  GRAPH <https://w3id.org/thailex/graph/lexitron> {
    ?entry a ontolex:LexicalEntry ;
           ontolex:sense ?sense .
    OPTIONAL { ?sense tlkg:hasDefinition ?definition }
  }
}
