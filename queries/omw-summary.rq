PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX tlkg: <https://w3id.org/thailex/ontology/>

SELECT ?thaiEntryCount ?thaiSenseCount ?thaiSynsetCount ?alignedSynsetCount
       ?englishSynsetCount ?definitionCount ?relationCount
WHERE {
  {
    SELECT (COUNT(DISTINCT ?entry) AS ?thaiEntryCount)
           (COUNT(DISTINCT ?sense) AS ?thaiSenseCount)
    WHERE {
      GRAPH <https://w3id.org/thailex/graph/thai-wordnet> {
        ?entry a ontolex:LexicalEntry ; ontolex:sense ?sense .
      }
    }
  }
  {
    SELECT (COUNT(DISTINCT ?synset) AS ?thaiSynsetCount)
           (COUNT(DISTINCT ?english) AS ?alignedSynsetCount)
    WHERE {
      GRAPH <https://w3id.org/thailex/graph/thai-wordnet> {
        ?synset a ontolex:LexicalConcept .
        OPTIONAL { ?synset skos:exactMatch ?english }
      }
    }
  }
  {
    SELECT (COUNT(DISTINCT ?synset) AS ?englishSynsetCount)
    WHERE {
      GRAPH <https://w3id.org/thailex/graph/omw-en> {
        ?synset a ontolex:LexicalConcept .
      }
    }
  }
  {
    SELECT (COUNT(DISTINCT ?definition) AS ?definitionCount)
    WHERE {
      GRAPH <https://w3id.org/thailex/graph/omw-en> {
        ?synset tlkg:hasSynsetDefinition ?definition .
      }
    }
  }
  {
    SELECT (COUNT(DISTINCT ?relation) AS ?relationCount)
    WHERE {
      GRAPH <https://w3id.org/thailex/graph/omw-en> {
        ?relation a tlkg:RelationAssertion .
      }
    }
  }
}
